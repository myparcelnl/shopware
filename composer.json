{
  "name": "myparcelnl/shopware",
  "description": "MyParcel plugin for Shopware 6.7+ (PDK-based)",
  "type": "shopware-platform-plugin",
  "license": "MIT",
  "version": "0.1.0",
  "require": {
    "php": ">=8.2",
    "myparcelnl/pdk": "^4.1",
    "myparcelnl/sdk": "^11.0.0-beta.28@beta",
    "guzzlehttp/guzzle": "^7.5"
  },
  "extra": {
    "shopware-plugin-class": "MyParcelNL\\Shopware\\MyParcelNLShopware",
    "label": {
      "en-GB": "MyParcel",
      "nl-NL": "MyParcel",
      "de-DE": "MyParcel"
    },
    "description": {
      "en-GB": "MyParcel integration for Shopware",
      "nl-NL": "MyParcel integratie voor Shopware",
      "de-DE": "MyParcel Integration für Shopware"
    }
  },
  "autoload": {
    "psr-4": {
      "MyParcelNL\\Shopware\\": "src/"
    }
  },
  "scripts": {
    "scope": "bin/scope.sh"
  },
  "scripts-descriptions": {
    "scope": "Produce a vendor directory scoped with the _MyParcelNL prefix"
  },
  "config": {
    "prepend-autoloader": false
  }
}
