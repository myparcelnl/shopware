<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="MyParcelNL\Shopware\Pdk\PdkInitializer">
            <argument type="service" id="monolog.logger.myparcel"/>
            <argument>%myparcel.plugin_version%</argument>
            <argument>%env(string:APP_URL)%</argument>
            <argument>%kernel.debug%</argument>
        </service>

        <service id="MyParcelNL\Shopware\Controller\PdkController" public="true">
            <argument type="service" id="MyParcelNL\Shopware\Pdk\PdkInitializer"/>
            <tag name="controller.service_arguments"/>
        </service>
    </services>
</container>
