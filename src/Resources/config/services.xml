<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="MyParcel\Shopware\Entity\OrderData\OrderDataDefinition">
            <tag name="shopware.entity.definition" entity="myparcel_order_data"/>
        </service>

        <service id="MyParcel\Shopware\Entity\OrderShipment\OrderShipmentDefinition">
            <tag name="shopware.entity.definition" entity="myparcel_order_shipment"/>
        </service>

        <service id="MyParcel\Shopware\Entity\OrderExtension">
            <tag name="shopware.entity.extension"/>
        </service>

        <service id="MyParcel\Shopware\Pdk\Storage\SystemConfigStorage">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>

        <service id="MyParcel\Shopware\Pdk\Language\ShopwareLocaleResolver">
            <argument type="service" id="request_stack"/>
            <argument type="service" id="Shopware\Core\Framework\App\AppLocaleProvider"/>
        </service>

        <service id="MyParcel\Shopware\Pdk\Language\RequestCachedLocaleResolver">
            <argument type="service" id="MyParcel\Shopware\Pdk\Language\ShopwareLocaleResolver"/>
            <argument type="service" id="request_stack"/>
        </service>

        <service id="MyParcel\Shopware\Pdk\Routing\ShopwareUrlResolver">
            <argument type="service" id="router"/>
        </service>

        <service id="MyParcel\Shopware\Pdk\Currency\EuroCurrency">
            <argument type="service" id="currency.repository"/>
        </service>

        <service id="MyParcel\Shopware\Pdk\Order\Writer\OrderDataWriter">
            <argument type="service" id="myparcel_order_data.repository"/>
            <argument type="service" id="myparcel_order_shipment.repository"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="MyParcel\Shopware\Pdk\Product\Writer\ProductSettingsWriter">
            <argument type="service" id="product.repository"/>
        </service>

        <service id="MyParcel\Shopware\Pdk\Order\State\OrderStateTransitioner">
            <argument type="service" id="order.repository"/>
            <argument type="service" id="Shopware\Core\System\StateMachine\StateMachineRegistry"/>
            <argument type="service" id="monolog.logger.myparcel"/>
        </service>

        <service id="MyParcel\Shopware\Pdk\Frontend\ViewService">
            <argument type="service" id="request_stack"/>
        </service>

        <service id="MyParcel\Shopware\Pdk\Order\OrderStatusService">
            <argument type="service" id="state_machine_state.repository"/>
            <argument type="service" id="language.repository"/>
            <argument type="service" id="request_stack"/>
            <argument type="service" id="MyParcel\Shopware\Pdk\Language\RequestCachedLocaleResolver"/>
            <argument type="service" id="MyParcel\Shopware\Pdk\Order\State\OrderStateTransitioner"/>
        </service>

        <service id="MyParcel\Shopware\Checkout\SalesChannelContextHolder">
            <tag name="kernel.reset" method="reset"/>
        </service>

        <service id="MyParcel\Shopware\Checkout\ShopwareCartLoader">
            <argument type="service" id="Shopware\Core\Checkout\Cart\SalesChannel\CartService"/>
        </service>

        <service id="MyParcel\Shopware\Pdk\PdkInitializer">
            <argument type="service" id="monolog.logger.myparcel"/>
            <argument type="service" id="MyParcel\Shopware\Pdk\Storage\SystemConfigStorage"/>
            <argument type="service" id="MyParcel\Shopware\Pdk\Language\RequestCachedLocaleResolver"/>
            <argument type="service" id="MyParcel\Shopware\Pdk\Routing\ShopwareUrlResolver"/>
            <argument type="service" id="order.repository"/>
            <argument type="service" id="product.repository"/>
            <argument type="service" id="MyParcel\Shopware\Pdk\Currency\EuroCurrency"/>
            <argument type="service" id="MyParcel\Shopware\Pdk\Order\Writer\OrderDataWriter"/>
            <argument type="service" id="MyParcel\Shopware\Pdk\Product\Writer\ProductSettingsWriter"/>
            <argument type="service" id="MyParcel\Shopware\Pdk\Frontend\ViewService"/>
            <argument type="service" id="MyParcel\Shopware\Pdk\Order\OrderStatusService"/>
            <argument type="service" id="shipping_method.repository"/>
            <argument type="service" id="MyParcel\Shopware\Checkout\SalesChannelContextHolder"/>
            <argument type="service" id="MyParcel\Shopware\Checkout\ShopwareCartLoader"/>
            <argument>%myparcel.plugin_version%</argument>
            <argument>%env(string:APP_URL)%</argument>
            <argument>%kernel.debug%</argument>
        </service>

        <service id="MyParcel\Shopware\Pdk\Http\PdkHttpBridge">
            <argument type="service" id="MyParcel\Shopware\Pdk\PdkInitializer"/>
            <argument type="service" id="monolog.logger.myparcel"/>
            <argument>%kernel.debug%</argument>
        </service>

        <service id="MyParcel\Shopware\Pdk\Webhook\WebhookUrlValidator"/>

        <service id="MyParcel\Shopware\Controller\AdminPdkController" public="true">
            <argument type="service" id="MyParcel\Shopware\Pdk\Http\PdkHttpBridge"/>
            <tag name="controller.service_arguments"/>
        </service>

        <service id="MyParcel\Shopware\Admin\AdminAssets">
            <argument type="service" id="assets.packages"/>
        </service>

        <service id="MyParcel\Shopware\Pdk\Frontend\AdminViewRenderer">
            <argument type="service" id="MyParcel\Shopware\Pdk\PdkInitializer"/>
            <argument type="service" id="request_stack"/>
        </service>

        <service id="MyParcel\Shopware\Controller\AdminViewController" public="true">
            <argument type="service" id="MyParcel\Shopware\Pdk\Http\PdkHttpBridge"/>
            <argument type="service" id="MyParcel\Shopware\Pdk\Frontend\AdminViewRenderer"/>
            <argument type="service" id="MyParcel\Shopware\Admin\AdminAssets"/>
            <tag name="controller.service_arguments"/>
        </service>

        <service id="MyParcel\Shopware\Checkout\DeliveryOptionsRenderer">
            <argument type="service" id="MyParcel\Shopware\Pdk\PdkInitializer"/>
            <argument type="service" id="MyParcel\Shopware\Checkout\SalesChannelContextHolder"/>
        </service>

        <service id="MyParcel\Shopware\Checkout\Subscriber\CheckoutConfirmPageSubscriber">
            <argument type="service" id="MyParcel\Shopware\Checkout\DeliveryOptionsRenderer"/>
            <argument type="service" id="monolog.logger.myparcel"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="MyParcel\Shopware\Controller\StorefrontPdkController" public="true">
            <argument type="service" id="MyParcel\Shopware\Pdk\Http\PdkHttpBridge"/>
            <argument type="service" id="MyParcel\Shopware\Checkout\SalesChannelContextHolder"/>
            <tag name="controller.service_arguments"/>
        </service>

        <service id="MyParcel\Shopware\Controller\WebhookController" public="true">
            <argument type="service" id="MyParcel\Shopware\Pdk\Http\PdkHttpBridge"/>
            <argument type="service" id="MyParcel\Shopware\Pdk\Storage\SystemConfigStorage"/>
            <argument type="service" id="MyParcel\Shopware\Pdk\Webhook\WebhookUrlValidator"/>
            <argument type="service" id="monolog.logger.myparcel"/>
            <tag name="controller.service_arguments"/>
        </service>

        <service id="MyParcel\Shopware\Command\AccountShowCommand">
            <argument type="service" id="MyParcel\Shopware\Pdk\PdkInitializer"/>
            <tag name="console.command"/>
        </service>

        <service id="MyParcel\Shopware\Command\AccountUpdateCommand">
            <argument type="service" id="MyParcel\Shopware\Pdk\PdkInitializer"/>
            <tag name="console.command"/>
        </service>
    </services>
</container>
