{% block sw_product_detail_content_tabs_additional %}
    {% parent %}

    <sw-tabs-item
        v-if="acl.can('myparcel.access') && $route.params.id"
        class="myparcel-product-detail__tab"
        :route="myparcelTabRoute"
        :title="$tc('myparcel.plugin_title_short')"
    >
        {{ $tc('myparcel.plugin_title_short') }}
    </sw-tabs-item>
{% endblock %}

{% block sw_product_detail_content_view %}
    {% parent %}

    <myparcel-product-settings
        v-if="myparcelSettingsOpened"
        v-show="isMyparcelRoute"
        ref="myparcelProductSettings"
    />
{% endblock %}
