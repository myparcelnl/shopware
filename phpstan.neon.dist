includes:
  - phpstan-baseline.php

parameters:
  level: 5
  tmpDir: .tmp/phpstan
  parallel:
    maximumNumberOfProcesses: 4
  paths:
    - src
  # src/ is not scoped and references two worlds at once: the _MyParcel-prefixed
  # copies inside the scoped vendor, and Shopware with its own Symfony runtime in
  # the development install. Each lives in its own directory.
  scanDirectories:
    - vendor
    - .tmp/dev-vendor
